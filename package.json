{
  "name": "@igaozp/dsh-font-settings",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igaozp/dsh-font-settings.git"
  },
  "type": "module",
  "description": "为 DeepSeek Harness 添加字体设置",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml", "PUBLISHING.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
