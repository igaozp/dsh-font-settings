{
  "name": "@igaozp/dsh-font-settings",
  "version": "1.0.0",
  "type": "module",
  "description": "在 DSH 设置 → 通用中添加界面字体与代码字体设置；字体候选来自本机已安装字体。",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
